{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "log.jsonl event, contract v1",
 "description": "One line of log.jsonl. Events and fields not listed here are allowed and must be ignored by readers.",
 "type": "object",
 "required": [
  "t",
  "event"
 ],
 "properties": {
  "t": {
   "type": "number",
   "description": "epoch seconds, writer's clock"
  },
  "event": {
   "type": "string"
  },
  "seq": {
   "type": "integer",
   "description": "added by the HTTP reader: 1-based line number"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_start"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 一轮分拣开始；列出扫描找到的全部物块",
    "properties": {
     "run": {
      "type": "string"
     },
     "cubes": {
      "type": "array"
     },
     "registration": {
      "type": "object"
     }
    },
    "required": [
     "run",
     "cubes",
     "registration"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_sorted"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 一块已放到它的目标位",
    "properties": {
     "cube": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "category": {
      "enum": [
       "recyclable",
       "kitchen",
       "hazardous",
       "other"
      ]
     },
     "bin": {
      "type": "string"
     },
     "seconds": {
      "type": "number"
     },
     "source": {
      "type": "string"
     },
     "slot": {
      "type": "integer"
     },
     "drop_map_cm": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     }
    },
    "required": [
     "cube",
     "category",
     "bin",
     "seconds"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_missed"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 夹空或搬运途中滑脱",
    "properties": {
     "cube": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "category": {
      "anyOf": [
       {
        "enum": [
         "recyclable",
         "kitchen",
         "hazardous",
         "other"
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "reason": {
      "type": "string"
     },
     "seconds": {
      "type": "number"
     }
    },
    "required": [
     "cube",
     "category",
     "reason",
     "seconds"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_skip"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 没有去抓：类别证据不足、够不着、已在目标位等",
    "properties": {
     "cube": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "category": {
      "anyOf": [
       {
        "enum": [
         "recyclable",
         "kitchen",
         "hazardous",
         "other"
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "cube",
     "category",
     "reason"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_approach_failed"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 接近途中遇阻，放弃这一块并退回观察位",
    "properties": {
     "cube": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "category": {
      "anyOf": [
       {
        "enum": [
         "recyclable",
         "kitchen",
         "hazardous",
         "other"
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "reason": {
      "type": "string"
     },
     "seconds": {
      "type": "number"
     }
    },
    "required": [
     "cube",
     "category",
     "reason",
     "seconds"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_put_failed"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 夹住了但放不到目标位，已就地或原位放下",
    "properties": {
     "cube": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "category": {
      "anyOf": [
       {
        "enum": [
         "recyclable",
         "kitchen",
         "hazardous",
         "other"
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "bin": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "released": {
      "type": "string"
     }
    },
    "required": [
     "cube",
     "category",
     "bin",
     "reason"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_cleared"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 把挡在别的目标位上的块先挪开（不算分拣完成）",
    "properties": {
     "cube": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "category": {
      "anyOf": [
       {
        "enum": [
         "recyclable",
         "kitchen",
         "hazardous",
         "other"
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "bin": {
      "type": "string"
     },
     "seconds": {
      "type": "number"
     },
     "source": {
      "type": "string"
     }
    },
    "required": [
     "cube",
     "category",
     "bin",
     "seconds"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_stuck"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 剩下的块互相挡着且挪不开，本轮到此为止",
    "properties": {
     "bin": {
      "type": "string"
     },
     "blocker": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     }
    },
    "required": [
     "bin",
     "blocker"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_end"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 一轮结束及计数",
    "properties": {
     "run": {
      "type": "string"
     },
     "sorted": {
      "type": "integer"
     },
     "skipped": {
      "type": "integer"
     },
     "missed": {
      "type": "integer"
     },
     "cleared": {
      "type": "integer"
     },
     "seconds": {
      "type": "number"
     }
    },
    "required": [
     "run",
     "sorted",
     "skipped",
     "missed",
     "cleared",
     "seconds"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "scan_view"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 扫描到第几个视角",
    "properties": {
     "run": {
      "type": "string"
     },
     "view": {
      "type": "integer"
     },
     "pose": {
      "type": "array",
      "items": {
       "type": [
        "number",
        "null"
       ]
      },
      "minItems": 6,
      "maxItems": 6
     },
     "markers": {
      "anyOf": [
       {
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "official": {
      "type": "array"
     }
    },
    "required": [
     "run",
     "view",
     "pose"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "gripped"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 合爪后的读回判定",
    "properties": {
     "pose": {
      "type": "array",
      "items": {
       "type": [
        "number",
        "null"
       ]
      },
      "minItems": 6,
      "maxItems": 6
     },
     "grip": {
      "type": "object"
     },
     "tip_cm": {
      "type": "array"
     }
    },
    "required": [
     "pose",
     "grip"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "put"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 已在目标位松手",
    "properties": {
     "target": {
      "type": "string"
     },
     "released_at": {
      "type": "array",
      "items": {
       "type": [
        "number",
        "null"
       ]
      },
      "minItems": 6,
      "maxItems": 6
     },
     "target_map_cm": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "pose": {
      "type": "array",
      "items": {
       "type": [
        "number",
        "null"
       ]
      },
      "minItems": 6,
      "maxItems": 6
     }
    },
    "required": [
     "target",
     "released_at"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "gripper_not_closed"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 夹爪舵机没有响应合爪指令",
    "properties": {
     "attempt": {
      "type": "integer"
     },
     "readback": {
      "type": "number"
     }
    },
    "required": [
     "attempt",
     "readback"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "gripper_awake"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 小步唤醒后夹爪恢复响应",
    "properties": {
     "start": {
      "type": "number"
     },
     "readback": {
      "type": "number"
     }
    },
    "required": [
     "start",
     "readback"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "gripper_still_asleep"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 唤醒后夹爪仍不响应",
    "properties": {
     "start": {
      "type": "number"
     },
     "readback": {
      "type": "number"
     }
    },
    "required": [
     "start",
     "readback"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "gripper_wake_refused"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 唤醒动作被控制台拒绝",
    "properties": {
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "reason"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "stopped"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 任务中止",
    "properties": {
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "reason"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "bins_located"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 实体垃圾桶按贴纸定位的结果（每桶一项：桶号、类别、位置、朝向、是找到的还是设计位置）",
    "properties": {
     "design": {
      "type": "string"
     },
     "bins": {
      "type": "array"
     }
    },
    "required": [
     "design",
     "bins"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "bin_full"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 某个容器已满（按够得着的落点数算），不再向它投放；该类物块被跳过",
    "properties": {
     "bin": {
      "type": "string"
     },
     "count": {
      "type": "integer"
     },
     "category": {
      "enum": [
       "recyclable",
       "kitchen",
       "hazardous",
       "other"
      ]
     },
     "by": {
      "type": "string"
     }
    },
    "required": [
     "bin",
     "count"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "table_z_disagrees"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 扫描得到的桌面高度与标定值相差过大，需重新标定",
    "properties": {
     "scan_cm": {
      "type": "number"
     },
     "calibrated_cm": {
      "type": "number"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "scan_cm",
     "calibrated_cm"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "interaction"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 手势或语音触发、且已被受理执行的指令（E1、E7）；被忽略或拒绝的不写；语音没有 confidence",
    "properties": {
     "source": {
      "type": "string"
     },
     "command": {
      "type": "string"
     },
     "confidence": {
      "type": "number"
     },
     "detail": {
      "type": "string"
     }
    },
    "required": [
     "source",
     "command"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "step"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 分步流程的一步开始或结束（scan/plan/grasp/check/back_off/place/verify…，flow 为整轮）",
    "properties": {
     "session": {
      "type": "string"
     },
     "step": {
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "result": {
      "type": "string"
     },
     "summary": {
      "type": "string"
     },
     "block": {
      "type": "string"
     },
     "path": {
      "type": "string"
     }
    },
    "required": [
     "session",
     "step",
     "state"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "alarm"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 需要人知道的异常：空爪重试用尽、夹爪卡住、堵转等；needs_ack 为真时要有人确认",
    "properties": {
     "kind": {
      "type": "string"
     },
     "summary": {
      "type": "string"
     },
     "needs_ack": {
      "type": "boolean"
     },
     "block": {
      "type": "string"
     }
    },
    "required": [
     "kind",
     "summary",
     "needs_ack"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "alarm_ack"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 报警已被确认",
    "properties": {
     "kind": {
      "type": "string"
     },
     "by": {
      "type": "string"
     }
    },
    "required": [
     "kind",
     "by"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "speed"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 控制台速度改动（°/s）",
    "properties": {
     "speed": {
      "type": "number"
     },
     "source": {
      "type": "string"
     }
    },
    "required": [
     "speed",
     "source"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_retry"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 空爪后退回重扫、找回这一块再抓（attempt 第几次）",
    "properties": {
     "cube": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "category": {
      "anyOf": [
       {
        "enum": [
         "recyclable",
         "kitchen",
         "hazardous",
         "other"
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "attempt": {
      "type": "integer"
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "cube",
     "category",
     "attempt",
     "reason"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_retry_failed"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 空爪重试没能进行：退不回观察位、重扫失败或找不回这一块",
    "properties": {
     "cube": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "cube",
     "reason"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "pipeline_order"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 本轮抓取顺序：能做的块离基座的距离（m），由近及远（E5）",
    "properties": {
     "order": {
      "type": "array"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "order"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "gesture_gate"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 扫描后等操作员比 OK 手势（2026-11-19 板上版本写过；app 里由流程脚本 wait_gesture 代替）",
    "properties": {
     "state": {
      "type": "string"
     },
     "timeout_s": {
      "type": "number"
     },
     "need": {
      "type": "integer"
     },
     "seconds": {
      "type": "number"
     },
     "pose": {
      "type": "array"
     },
     "reason": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "state"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "event": {
      "const": "script_changed"
     }
    },
    "required": [
     "event"
    ]
   },
   "then": {
    "description": "[stable] 流程脚本在某一端被保存或删除；其他端据此重新拉取",
    "properties": {
     "name": {
      "type": "string"
     },
     "action": {
      "type": "string"
     },
     "by": {
      "type": "string"
     },
     "rev": {
      "anyOf": [
       {
        "type": "string"
       },
