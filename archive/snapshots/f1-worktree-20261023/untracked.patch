+++ b/src/web/task.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""任务轮次：一次 start = 一个任务 = 一轮（用户 2026-10-23 确认的口径）。
+
+YOLO/流水线事件只作为“本轮明细”：任务开始后出现的 `pipeline_start` 数当前轮、
+`pipeline_end` 数已完成轮。回放/历史日志（任务开始之前的 pipeline 事件）不计入。
+
+任务本身是网关概念：仿真后端用 `/api/sim/sort` 子进程实现，实机后端暂不支持
+（`Capabilities.task=False`），所以状态里如实给 `supported`，页面据此禁用按钮。
+"""
+from __future__ import annotations
+
+import threading
+import time
+from pathlib import Path
+
+from backends.base import BackendError
+
+# 任务开始时刻与日志事件 t 都是同一台机器的墙钟；留一点余量避免边界抖动
+START_SLACK = 0.5
+
+
+def _contract():
+    try:
+        import log_contract as L  # serve.py 已把 src/tools 放进 sys.path
+        return L
+    except ImportError:                      # 单独导入 task.py 时（测试）
+        import sys
+        root = Path(__file__).resolve().parents[2]
+        sys.path.insert(0, str(root / "src" / "tools"))
+        import log_contract as L
+        return L
+
+
+class TaskTracker:
+    MAX_OUTPUT = 12
+
+    def __init__(self, backend, log_path: Path, append_event):
+        self.backend = backend
+        self.log_path = Path(log_path)
+        self.append_event = append_event
+        self.lock = threading.Lock()
+        self.task: dict | None = None
+        self._polled_at = 0.0
+
+    # ---- 状态 ---------------------------------------------------------
+    @property
+    def supported(self) -> bool:
+        return bool(self.backend is not None and self.backend.capabilities.task)
+
+    def status(self) -> dict:
+        with self.lock:
+            if not self.supported:
+                return self._empty(state="idle", supported=False,
+                                   error=None if self.backend else "未接执行侧")
+            if self.task is None:
+                return self._empty(state="idle")
+            return dict(self.task)
+
+    @staticmethod
+    def _empty(state: str = "idle", supported: bool = True, error: str | None = None) -> dict:
+        return dict(supported=supported, id=None, state=state, running=False, source=None,
+                    rounds_requested=0, rounds_done=0, current_round=0,
+                    started_at=None, finished_at=None, exit_code=None,
+                    error=error, output=[])
+
+    # ---- 控制 ---------------------------------------------------------
+    def start(self, source: str = "web", rounds: int = 1, blocks: int = 4,
+              seed: int | None = None) -> dict:
+        rounds = max(1, int(rounds))
+        with self.lock:
+            if self.backend is None:
+                raise BackendError("未接控制台执行侧（--console），无法启动分拣任务", status=501,
+                                   code="task_unsupported")
+            if not self.supported:
+                raise BackendError("该执行侧暂不支持任务启停（实机任务启动待 H1-3 验收）",
+                                   status=501, code="task_unsupported")
+            if self.task and self.task.get("running"):
+                raise BackendError("任务已在运行", status=409, code="task_running")
+            backend = self.backend
+        # 任务要自己拿操作权；先释放网页持有的使能
+        try:
+            if backend.status().get("armed"):
+                backend.stop()
+        except BackendError:
+            pass
+        reply = backend.task_start(rounds=rounds, blocks=blocks, seed=seed)
+        now = time.time()
+        task = dict(id=f"task{int(now * 1000)}", state="running", running=True,
+                    source=source, rounds_requested=rounds, rounds_done=0,
+                    current_round=0, started_at=now, finished_at=None,
+                    exit_code=None, error=None, output=[],
+                    log_lines=(reply or {}).get("log_lines"))
+        with self.lock:
+            self.task = task
+            self._polled_at = now
+        try:
+            self.append_event(dict(t=now, event="interaction", source=source, command="start"))
+        except Exception:                       # 日志写失败不能连累任务本身
+            pass
+        return dict(self.task)
+
+    def stop(self, reason: str = "网页停止任务") -> dict:
+        with self.lock:
+            task = self.task
+            was_running = bool(task and task.get("running"))
+        backend = self.backend
+        if backend is not None and self.supported:
+            try:
+                backend.task_stop()
+            except BackendError as exc:
+                if not was_running:
+                    raise
+                with self.lock:
+                    self.task["error"] = exc.message
+        now = time.time()
+        with self.lock:
+            if self.task is None:
+                self.task = self._empty(state="stopped")
+            self.task.update(running=False, state="stopped", finished_at=now)
+        if was_running:
+            try:
+                self.append_event(dict(t=now, event="stopped", reason=reason))
+            except Exception:
+                pass
+        return dict(self.task)
+
+    # ---- 进度 ---------------------------------------------------------
+    def poll(self, force: bool = False) -> dict:
+        with self.lock:
+            task = self.task
+            if task is None or not task.get("running"):
+                return dict(task) if task else self._empty()
+            if not force and time.time() - self._polled_at < 0.4:
+                return dict(task)
+            self._polled_at = time.time()
+        backend = self.backend
+        state: dict = {}
+        error = None
+        try:
+            state = backend.task_state() if backend and self.supported else {}
+        except BackendError as exc:
+            error = exc.message
+        window = self._window(task["started_at"])
+        with self.lock:
+            task = self.task
+            if task is None:
+                return self._empty()
+            task["current_round"] = max(0, window["starts"])
+            task["rounds_done"] = window["ends"]
+            if state:
+                task["log_lines"] = state.get("log_lines", task.get("log_lines"))
+                task["output"] = list(state.get("output") or [])[-self.MAX_OUTPUT:]
+            if error:
+                task["error"] = error
+            running = bool(state.get("running")) if state else task["running"]
+            if state and not running:
+                exit_code = state.get("exit_code")
+                task.update(running=False, finished_at=time.time(), exit_code=exit_code)
+                task["state"] = "finished" if exit_code == 0 else "failed"
+                if exit_code not in (0, None) and not task.get("error"):
+                    task["error"] = f"分拣流水线退出码 {exit_code}"
+            return dict(task)
+
+    def _window(self, started_at: float) -> dict:
+        """任务开始之后的 pipeline_start / pipeline_end 数（只算本轮任务）。"""
+        L = _contract()
+        try:
+            events, _ = L.read(self.log_path)
+        except OSError:
+            return dict(starts=0, ends=0)
+        low = started_at - START_SLACK
+        starts = ends = 0
+        for event in events:
+            t = event.get("t")
+            if not isinstance(t, (int, float)) or t < low:
+                continue
+            if event.get("replay"):
+                continue                        # 回放样例不是当前任务
+            if event.get("event") == "pipeline_start":
+                starts += 1
+            elif event.get("event") == "pipeline_end":
+                ends += 1
+        return dict(starts=starts, ends=ends)
diff --git a/tests/test_backends.py b/tests/test_backends.py
new file mode 100644
index 0000000..b582914
--- /dev/null
+++ b/tests/test_backends.py
@@ -0,0 +1,170 @@
+"""执行侧后端：token/状态规范化/错误透传/能力标志/自动识别。标准库 unittest。
+
+用假控制台（ThreadingHTTPServer）而不是真仿真，这样可以在任何机器上跑，也不需要
+opencv/numpy。接口形状按 docs/atlas-200i-dk-a2/15-接口文档.md §4。
+"""
+import json
+import sys
+import threading
+import unittest
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'src' / 'web'))
+from backends import Capabilities, create_backend  # noqa: E402
+from backends.base import BackendError  # noqa: E402
+from backends.console import ConsoleBackend, probe_kind  # noqa: E402
+from backends.real import RealBackend  # noqa: E402
+from backends.sim import SimBackend  # noqa: E402
+
+POSE = [90, 105, 5, 5, 95, 30]
+
+
+class FakeConsole(BaseHTTPRequestHandler):
+    token = 'tok'
+    last = {}
+
+    def log_message(self, *args):
+        pass
+
+    def _send(self, payload, status=200):
+        body = json.dumps(payload, ensure_ascii=False).encode()
+        self.send_response(status)
+        self.send_header('Content-Type', 'application/json')
+        self.send_header('Content-Length', str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def do_GET(self):
+        if self.path == '/api/bootstrap':
+            return self._send(dict(token=self.token, scene=dict(marker='scene'),
+                                   status=dict(mode='simulation', pose=POSE, sim=dict(blocks=3))))
+        if self.path == '/api/status':
+            return self._send(dict(mode='simulation', pose=list(POSE), command=None, armed=False,
+                                   busy=False, revision=7, observed_at=1.0, age_s=0.1,
+                                   grip=dict(action=None, readback=None, holding=None, result=None),
+                                   fk=dict(tip=[0.0, 0.14, 0.04], tip_pitch_deg=[90.0],
+                                           shoulder=[0.0, 0.09, 0.0], elbow=[0.0, 0.09, 0.12]),
+                                   clearance_cm=1.8, limits={'1': [0, 180]}, sim=dict(blocks=3)))
+        if self.path == '/api/frame':
+            body = b'\xff\xd8fake'
+            self.send_response(200)
+            self.send_header('Content-Type', 'image/jpeg')
+            self.send_header('Content-Length', str(len(body)))
+            self.end_headers()
+            return self.wfile.write(body)
+        if self.path == '/api/sim/sort':
+            return self._send(dict(running=False, exit_code=0, output=[], log_lines=4))
+        return self._send({'error': 'no route'}, status=404)
+
+    def do_POST(self):
+        n = int(self.headers.get('Content-Length') or 0)
+        body = json.loads(self.rfile.read(n) or b'{}')
+        FakeConsole.last = dict(path=self.path, body=body, token=self.headers.get('X-Console-Token'))
+        if self.headers.get('X-Console-Token') != self.token:
+            return self._send({'error': '页面凭证过期，请刷新'}, status=409)
+        if self.path == '/api/jog':
+            POSE[1] += body.get('delta', 0)
+            return self._send(dict(ok=True))
+        if self.path == '/api/pose/plan':
+            return self._send(dict(id='plan1', revision=7, segments=2, target=body.get('target')))
+        if self.path == '/api/pose/execute':
+            return self._send(dict(ok=True))
+        if self.path == '/api/sim/sort':
+            return self._send(dict(running=True, exit_code=None, output=[], log_lines=0))
+        if self.path == '/api/boom':
+            return self._send({'error': '动作尚未结束'}, status=409)
+        return self._send(dict(ok=True))
+
+
+class BackendTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.httpd = ThreadingHTTPServer(('127.0.0.1', 0), FakeConsole)
+        cls.port = cls.httpd.server_address[1]
+        threading.Thread(target=cls.httpd.serve_forever, daemon=True).start()
+        cls.base = f'http://127.0.0.1:{cls.port}'
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.httpd.shutdown()
+        cls.httpd.server_close()
+
+    def test_probe_kind_uses_sim_key_not_mode(self):
+        # 实机控制台离线模拟的 mode 也是 simulation，只有 sim 键能区分
+        self.assertEqual(probe_kind(self.base), 'sim')
+
+    def test_console_backend_normalizes_pose_and_chain(self):
+        backend = ConsoleBackend(self.base)
+        status = backend.status()
+        self.assertEqual(status['pose'], POSE)
+        self.assertEqual(status['chain_cm']['base'], [0.0, 0.0, 0.0])
+        self.assertAlmostEqual(status['tip_cm'][1], 14.0)
+        self.assertEqual(status['tip_pitch_deg'], 90.0)
+        self.assertEqual(backend.token, 'tok')
+
+    def test_motion_sends_token_owner_and_fresh_revision(self):
+        backend = ConsoleBackend(self.base, owner='web')
+        before = backend.status()['pose'][1]
+        backend.jog(2, 5)
+        self.assertEqual(FakeConsole.last['path'], '/api/jog')
+        self.assertEqual(FakeConsole.last['body']['owner'], 'web')
+        self.assertEqual(FakeConsole.last['body']['revision'], 7)
+        self.assertEqual(FakeConsole.last['token'], 'tok')
+        self.assertEqual(backend.status()['pose'][1], before + 5)
+
+    def test_console_error_message_and_status_pass_through(self):
+        backend = ConsoleBackend(self.base)
+        with self.assertRaises(BackendError) as ctx:
+            backend._request('/api/boom', dict(owner='web'))
+        self.assertEqual(ctx.exception.status, 409)
+        self.assertEqual(ctx.exception.message, '动作尚未结束')
+
+    def test_stale_console_token_is_refetched_once(self):
+        backend = ConsoleBackend(self.base)
+        backend.token = 'stale'
+        backend.jog(2, 1)                  # 409「凭证过期」→ 重取 token → 成功
+        self.assertEqual(backend.token, 'tok')
+        self.assertEqual(FakeConsole.last['token'], 'tok')
+
+    def test_scene_and_frame(self):
+        backend = ConsoleBackend(self.base)
+        self.assertEqual(backend.scene()['marker'], 'scene')
+        self.assertTrue(backend.frame().startswith(b'\xff\xd8'))
+
+    def test_sim_backend_declares_task_and_world(self):
+        backend = SimBackend(self.base)
+        caps = backend.capabilities
+        self.assertTrue(caps.task and caps.sim_world and caps.detect)
+        self.assertFalse(caps.onsite)
+        task = backend.task_start(rounds=1)
+        self.assertTrue(task['running'])
+        self.assertEqual(backend.task_state()['supported'], True)
+
+    def test_real_backend_refuses_task_start_but_keeps_motion(self):
+        backend = RealBackend(self.base)
+        self.assertFalse(backend.capabilities.task)
+        self.assertTrue(backend.capabilities.onsite)
+        with self.assertRaises(BackendError) as ctx:
+            backend.task_start(rounds=1)
+        self.assertEqual(ctx.exception.status, 501)
+        plan = backend.pose_plan([90, 100, 10, 10, 95])
+        self.assertEqual(plan['id'], 'plan1')
+
+    def test_create_backend_auto_detects_sim(self):
+        backend = create_backend(self.base, owner='web')
+        self.assertIsInstance(backend, SimBackend)
+        self.assertIsInstance(create_backend(self.base, kind='real'), RealBackend)
+        self.assertIsNone(create_backend(None))
+
+
+class CapabilitiesTest(unittest.TestCase):
+    def test_defaults_are_explicitly_false(self):
+        caps = Capabilities().as_dict()
+        self.assertTrue(caps)
+        self.assertFalse(any(caps.values()))
+
+
+if __name__ == '__main__':
+    unittest.main()
