+#!/usr/bin/env python3
+"""实机控制台后端（`src/teleop/server.py`）。
+
+与仿真后端同层：状态、运动、姿态规划、回观察位、档位、录制/采样/标定都走控制台
+接口（接口文档 §4），限位/禁入区/操作权仍由控制台把关。
+
+任务启停（跑一整轮分拣）在实机侧还没有验收过入口：`src/pipeline/run.py` 是人工
+守着的脚本，不能由网页无人确认地拉起。所以 `task` 能力为 False，明确返回 501，
+而不是假装能启动。
+"""
+from __future__ import annotations
+
+from .base import BackendError, Capabilities
+from .console import ConsoleBackend
+
+
+class RealBackend(ConsoleBackend):
+    kind = "real"
+    name = "实机控制台"
+
+    @property
+    def capabilities(self) -> Capabilities:
+        return Capabilities(
+            camera=True, task=False, task_rounds=False, pose=True, home=True,
+            profile=True, gripper=True, record=True, sample=True, verify=True,
+            freeze=True, calibrate=True, measure=True, export=True,
+            sim_world=False, detect=False, onsite=True,
+        )
+
+    def task_start(self, rounds: int = 1, blocks: int = 4, seed: int | None = None) -> dict:
+        raise BackendError("实机任务启停尚未接入（需先验收流水线入口，H1-3）",
+                           status=501, code="task_unsupported")
+
+    def task_stop(self) -> dict:
+        raise BackendError("实机任务启停尚未接入（需先验收流水线入口，H1-3）",
+                           status=501, code="task_unsupported")
