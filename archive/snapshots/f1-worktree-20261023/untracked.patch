+"""网关新接口的 HTTP 层测试：后端/任务/控制台 §4 代理/archive 解码/跨源防护。
+
+用进程内假后端，不连仿真控制台，也不需要 cv2/onnxruntime。
+"""
+import json
+import sys
+import tempfile
+import threading
+import time
+import unittest
+import urllib.error
+import urllib.request
+from http.server import ThreadingHTTPServer
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'src' / 'web'))
+sys.path.insert(0, str(ROOT / 'src' / 'tools'))
+import serve as S  # noqa: E402
+from backends.base import BackendError, Capabilities  # noqa: E402
+from backends.sim import SimBackend  # noqa: E402
+from task import TaskTracker  # noqa: E402
+
+
+class FakeBackend:
+    kind = 'sim'
+    address = 'http://fake'
+    name = '假仿真'
+
+    def __init__(self):
+        self.capabilities = Capabilities(camera=True, task=True, pose=True, home=True,
+                                         profile=True, gripper=True, sim_world=True)
+        self.pose = [90, 105, 5, 5, 95, 30]
+        self.armed = False
+        self.task_running = False
+        self.jogged = []
+        self.task_started = 0
+
+    def describe(self, connected=True, error=None):
+        return dict(kind=self.kind, name=self.name, address=self.address, connected=connected,
+                    error=error, capabilities=self.capabilities.as_dict())
+
+    def status(self):
+        return dict(mode='simulation', pose=list(self.pose), command=None, armed=self.armed,
+                    busy=False, revision=5, observed_at=time.time(), age_s=0.1,
+                    grip=dict(action=None, readback=None, holding=None, result=None),
+                    fk=dict(tip=[0.0, 0.14, 0.04], tip_pitch_deg=[90.0]),
+                    clearance_cm=1.8, limits={'1': [0, 180]}, sim=dict(blocks=2))
+
+    def scene(self):
+        return {'marker': 'fake'}
+
+    def enable(self, onsite=False):
+        self.armed = True
+        return self.status()
+
+    def heartbeat(self):
+        return self.status()
+
+    def stop(self):
+        self.armed = False
+        return self.status()
+
+    def jog(self, joint, delta, revision=None):
+        self.jogged.append((joint, delta))
+        self.pose[joint - 1] += delta
+        return self.status()
+
+    def pose_plan(self, target):
+        return dict(id='p1', revision=5, segments=1, target=list(target))
+
+    def pose_execute(self, plan_id, revision):
+        return self.status()
+
+    def frame(self):
+        return b'\xff\xd8fake'
+
+    def task_start(self, rounds=1, blocks=4, seed=None):
+        self.task_running = True
+        self.task_started += 1
+        return dict(running=True, exit_code=None, output=[], log_lines=0)
+
+    def task_stop(self):
+        self.task_running = False
+        return dict(running=False)
+
+    def task_state(self):
+        return dict(running=self.task_running, exit_code=None if self.task_running else 0,
+                    output=[], log_lines=0)
+
+    def close(self):
+        pass
+
+
+class ApiTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp = tempfile.TemporaryDirectory()
+        cls.root = Path(cls.tmp.name)
+        cls.log = cls.root / 'log.jsonl'
+        cls.log.write_text('', encoding='utf-8')
+        cls.archive = cls.root / 'archive'
+        cls.archive.mkdir()
+        (cls.archive / '未知 图.png').write_bytes(b'\x89PNG\r\n')
+        cls.backend = FakeBackend()
+        cls.state = S.State(cls.log, backend=cls.backend, archive=cls.archive, owner='web')
+        cls.state.refresh_backend()
+        cls.httpd = ThreadingHTTPServer(('127.0.0.1', 0), S.Handler)
+        cls.httpd.state = cls.state
+        cls.port = cls.httpd.server_address[1]
+        cls.base = f'http://127.0.0.1:{cls.port}'
+        threading.Thread(target=cls.httpd.serve_forever, daemon=True).start()
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.httpd.shutdown()
+        cls.httpd.server_close()
+        cls.tmp.cleanup()
+
+    def get(self, path, headers=None):
+        req = urllib.request.Request(self.base + path, headers=headers or {})
+        try:
+            with urllib.request.urlopen(req, timeout=5) as res:
+                return res.status, res.read(), res.headers
+        except urllib.error.HTTPError as exc:
+            return exc.code, exc.read(), exc.headers
+
+    def get_json(self, path):
+        status, body, _ = self.get(path)
+        return status, json.loads(body)
+
+    def post(self, path, body, headers=None):
+        req = urllib.request.Request(self.base + path, data=json.dumps(body).encode(), method='POST',
+                                     headers=dict({'Content-Type': 'application/json'}, **(headers or {})))
+        try:
+            with urllib.request.urlopen(req, timeout=10) as res:
+                return res.status, json.loads(res.read() or b'{}')
+        except urllib.error.HTTPError as exc:
+            return exc.code, json.loads(exc.read() or b'{}')
+
+    def event(self, name, t=None, **fields):
+        with self.log.open('a', encoding='utf-8') as f:
+            f.write(json.dumps(dict(event=name, t=time.time() if t is None else t, **fields)) + '\n')
+
+    # ---- 状态/后端 ----------------------------------------------------
+    def test_status_pose_comes_from_backend_not_log(self):
+        self.event('scan_view', pose=[1, 2, 3, 4, 5, 6])
+        self.state.refresh_backend()
+        _, status = self.get_json('/api/status')
+        self.assertEqual(status['joints_deg'], self.backend.pose)
+        self.assertEqual(status['arm']['joints_deg'], self.backend.pose)
+        self.assertEqual(status['backend']['kind'], 'sim')
+        self.assertTrue(status['backend']['capabilities']['task'])
+
+    def test_backend_scene_and_arm_get(self):
+        status, body, _ = self.get('/api/arm/scene')
+        self.assertEqual(status, 200)
+        self.assertEqual(json.loads(body)['scene']['marker'], 'fake')
+        status, body, _ = self.get('/api/arm/frame')
+        self.assertEqual(status, 200)
+        self.assertTrue(body.startswith(b'\xff\xd8'))
+
+    # ---- 控制台 §4 代理 -------------------------------------------------
+    def test_jog_proxied_and_motion_serialized(self):
+        status, body = self.post('/api/arm/jog', {'joint': 2, 'delta': 5})
+        self.assertEqual(status, 200)
+        self.assertTrue(body['ok'])
+        self.assertEqual(self.backend.jogged[-1], (2, 5))
+
+    def test_unknown_arm_path_is_404(self):
+        status, body = self.post('/api/arm/sim/reset', {'count': 1})
+        self.assertEqual(status, 404)
+        status, body = self.post('/api/arm/../../etc', {})
+        self.assertEqual(status, 404)
+
+    def test_pose_plan_and_execute(self):
+        status, body = self.post('/api/arm/pose/plan', {'target': [90, 100, 10, 10, 95]})
+        self.assertEqual(status, 200)
+        plan = body['plan']
+        status, body = self.post('/api/arm/pose/execute',
+                                 {'plan_id': plan['id'], 'revision': plan['revision']})
+        self.assertEqual(status, 200)
+
+    # ---- 任务 ----------------------------------------------------------
+    def test_task_start_is_one_round_and_counts_own_events(self):
+        self.event('pipeline_start', t=time.time() - 100)       # 历史，不计入
+        status, body = self.post('/api/task', {'action': 'start', 'rounds': 1})
+        self.assertEqual(status, 200)
+        started = body['task']['started_at']
+        self.event('pipeline_start')
+        self.event('pipeline_end', sorted=1, skipped=0, missed=0, cleared=0, seconds=2)
+        self.state.task.poll(force=True)
+        _, body = self.get_json('/api/task')
+        task = body['task']
+        self.assertEqual(task['current_round'], 1)
+        self.assertEqual(task['rounds_done'], 1)
+        _, body = self.get_json(f'/api/log/records?since={started}')
+        self.assertEqual(len(body['records']), 0)               # 只有 sorted 事件，不算 record
+        self.backend.task_running = False
+        self.state.task.poll(force=True)
+        _, body = self.get_json('/api/task')
+        self.assertEqual(body['task']['state'], 'finished')
+
+    def test_replay_events_do_not_dirty_task_records(self):
+        started = time.time()
+        self.event('pipeline_start', t=started + 1, replay=True)
+        self.event('pipeline_sorted', t=started + 1, replay=True, cube=[1, 2], category='other',
+                   bin='44', seconds=1)
+        _, body = self.get_json(f'/api/log/records?since={started}')
+        self.assertEqual(body['records'], [])
+        _, body = self.get_json('/api/log/records')
+        self.assertTrue(any(r['seq'] for r in body['records']))  # 全量历史仍可看
+
+    # ---- archive / 安全 -------------------------------------------------
+    def test_archive_utf8_name_is_url_decoded(self):
+        encoded = '%E6%9C%AA%E7%9F%A5%20%E5%9B%BE.png'
+        status, body, headers = self.get('/api/archive/' + encoded)
+        self.assertEqual(status, 200)
+        self.assertTrue(body.startswith(b'\x89PNG'))
+
+    def test_archive_traversal_is_refused(self):
+        status, _, _ = self.get('/api/archive/..%2Fserve.py')
+        self.assertEqual(status, 404)
+
+    def test_cross_origin_post_is_refused(self):
+        status, body = self.post('/api/arm/jog', {'joint': 2, 'delta': 1},
+                                 headers={'Origin': 'https://evil.example'})
+        self.assertEqual(status, 403)
+        self.assertEqual(body['code'], 'cross_origin')
+
+    def test_post_requires_json_content_type(self):
+        req = urllib.request.Request(self.base + '/api/arm/jog', data=b'joint=2',
+                                     method='POST', headers={'Content-Type': 'text/plain'})
+        with self.assertRaises(urllib.error.HTTPError) as ctx:
+            urllib.request.urlopen(req, timeout=5)
+        self.assertEqual(ctx.exception.code, 415)
+
+
+class TokenTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.log = Path(self.tmp.name) / 'log.jsonl'
+        self.log.write_text('', encoding='utf-8')
+        self.state = S.State(self.log, token='secret')
+        self.httpd = ThreadingHTTPServer(('127.0.0.1', 0), S.Handler)
+        self.httpd.state = self.state
+        self.port = self.httpd.server_address[1]
+        self.base = f'http://127.0.0.1:{self.port}'
+        threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
+
+    def tearDown(self):
+        self.httpd.shutdown()
+        self.httpd.server_close()
+
+    def test_token_via_query_sets_cookie_for_static_files(self):
+        status, body, headers = self._get('/?token=secret')
+        self.assertEqual(status, 200)
+        cookie = headers.get('Set-Cookie') or ''
+        self.assertIn('arm_web_token=secret', cookie)
+        status, body, _ = self._get('/js/app.js', headers={'Cookie': 'arm_web_token=secret'})
+        self.assertEqual(status, 200)
+
+    def test_without_token_is_401(self):
+        status, body, _ = self._get('/js/app.js')
+        self.assertEqual(status, 401)
+
+    def _get(self, path, headers=None):
+        req = urllib.request.Request(self.base + path, headers=headers or {})
+        try:
+            with urllib.request.urlopen(req, timeout=5) as res:
+                return res.status, res.read(), res.headers
+        except urllib.error.HTTPError as exc:
+            return exc.code, exc.read(), exc.headers
+
+
+if __name__ == '__main__':
+    unittest.main()
