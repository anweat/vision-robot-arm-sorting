+#!/usr/bin/env python3
+"""执行侧后端抽象：仿真控制台和实机控制台是同一等级的两个实现。
+
+网页/网关只面对 `ArmBackend`，不关心对端是 `src/sim/sim_server.py` 还是
+`src/teleop/server.py`。能做什么由 `Capabilities` 声明，页面按能力裁剪组件，
+而不是在页面里写 `if sim`。
+
+    SimBackend   kind=sim   有任务启停、仿真世界、检测对照
+    RealBackend  kind=real  任务启停还要接流水线入口（H1-3），先声明为不支持
+
+两者都通过控制台的 HTTP 接口（接口文档 §4）执行动作：限位、禁入区、操作权和
+revision 仍由控制台一处把关，这一层不重复实现安全边界。
+"""
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass, fields
+from typing import Any
+
+
+class BackendError(Exception):
+    """执行侧拒绝或不可达。`status` 是推荐回给浏览器的 HTTP 码，`code` 给前端做分支。"""
+
+    def __init__(self, message: str, status: int = 400, code: str | None = None,
+                 upstream: int | None = None):
+        super().__init__(message)
+        self.message = message
+        self.status = status
+        self.code = code
+        self.upstream = upstream
+
+    def as_dict(self) -> dict:
+        out = dict(ok=False, error=self.message)
+        if self.code:
+            out["code"] = self.code
+        return out
+
+
+@dataclass(frozen=True)
+class Capabilities:
+    """页面用这些标志决定显示什么；缺省一律 False，缺什么就明确不显示。"""
+
+    camera: bool = False
+    task: bool = False              # 网关任务启停（一次 start = 一轮）
+    task_rounds: bool = False       # 支持一次任务跑多轮
+    pose: bool = False              # /api/pose/plan + execute（J1–J5 单次规划）
+    home: bool = False              # /api/home/plan + execute（回观察位）
+    profile: bool = False           # /api/profile（限位档）
+    gripper: bool = False
+    record: bool = False
+    sample: bool = False
+    verify: bool = False
+    freeze: bool = False
+    calibrate: bool = False
+    measure: bool = False
+    export: bool = False
+    sim_world: bool = False
+    detect: bool = False
+    onsite: bool = False            # 使能必须现场确认（实机）
+
+    def as_dict(self) -> dict:
+        return {f.name: getattr(self, f.name) for f in fields(self)}
+
+
+class ArmBackend:
+    """执行侧接口。未实现的能力应抛 `BackendError(..., status=501, code=...)`。"""
+
+    kind = "offline"
+    name = "未接执行侧"
+
+    def __init__(self, address: str | None = None, owner: str = "web", timeout: float = 30.0):
+        self.address = (address or "").rstrip("/")
+        self.owner = owner
+        self.timeout = timeout
+
+    # ---- 元信息 -------------------------------------------------------
+    @property
+    def capabilities(self) -> Capabilities:
+        return Capabilities()
+
+    def describe(self, connected: bool = True, error: str | None = None) -> dict:
+        return dict(kind=self.kind, name=self.name, address=self.address or None,
+                    connected=connected, error=error,
+                    capabilities=self.capabilities.as_dict())
+
+    # ---- 查询 ---------------------------------------------------------
+    def bootstrap(self) -> dict:
+        raise BackendError("未接执行侧", status=501, code="no_backend")
+
+    def scene(self) -> dict | None:
+        return None
+
+    def status(self) -> dict:
+        raise BackendError("未接执行侧", status=501, code="no_backend")
+
+    # ---- 操作权 -------------------------------------------------------
+    def enable(self, onsite: bool = False) -> dict:
+        raise BackendError("未接执行侧", status=501, code="no_backend")
+
+    def heartbeat(self) -> dict:
+        raise BackendError("未接执行侧", status=501, code="no_backend")
+
+    def stop(self) -> dict:
+        raise BackendError("未接执行侧", status=501, code="no_backend")
+
+    # ---- 运动 ---------------------------------------------------------
+    def jog(self, joint: int, delta: int, revision: int | None = None) -> dict:
+        raise BackendError("未接执行侧", status=501, code="no_backend")
+
+    def cartesian(self, axis: str, amount: float, revision: int | None = None) -> dict:
+        raise BackendError("未接执行侧", status=501, code="no_backend")
+
+    def gripper(self, action: str, revision: int | None = None) -> dict:
+        raise BackendError("未接执行侧", status=501, code="no_backend")
+
+    def pose_plan(self, target: list) -> dict:
+        raise BackendError("该执行侧不支持姿态规划", status=501, code="pose_unsupported")
+
+    def pose_execute(self, plan_id: str, revision: int) -> dict:
+        raise BackendError("该执行侧不支持姿态规划", status=501, code="pose_unsupported")
+
+    def home_plan(self) -> dict:
+        raise BackendError("该执行侧不支持回观察位", status=501, code="home_unsupported")
+
+    def home_execute(self, plan_id: str, revision: int) -> dict:
+        raise BackendError("该执行侧不支持回观察位", status=501, code="home_unsupported")
+
+    def set_profile(self, name: str, onsite: bool = False) -> dict:
+        raise BackendError("该执行侧不支持档位切换", status=501, code="profile_unsupported")
+
+    # ---- 画面 ---------------------------------------------------------
+    def frame(self) -> bytes:
+        raise BackendError("该执行侧没有相机画面", status=404, code="camera_unsupported")
+
+    def phone_frame(self) -> bytes:
+        raise BackendError("该执行侧没有第二路相机", status=404, code="phone_unsupported")
+
+    def frozen_frame(self) -> bytes:
+        raise BackendError("还没有冻结帧", status=404, code="frozen_missing")
+
+    def annotated(self, which: str) -> bytes:
+        raise BackendError("该执行侧没有标注图", status=404, code="annotated_unsupported")
+
+    def export(self) -> dict:
+        raise BackendError("该执行侧不支持导出", status=501, code="export_unsupported")
+
+    # ---- 任务（网关概念，不是控制台接口） -----------------------------
+    def task_start(self, rounds: int = 1, blocks: int = 4, seed: int | None = None) -> dict:
+        raise BackendError("该执行侧暂不支持任务启动", status=501, code="task_unsupported")
+
+    def task_stop(self) -> dict:
+        raise BackendError("该执行侧暂不支持任务停止", status=501, code="task_unsupported")
+
+    def task_state(self) -> dict:
+        return dict(supported=False, running=False)
+
+    # ---- 生命周期 -----------------------------------------------------
+    def close(self) -> None:
+        pass
+
+    def __repr__(self) -> str:                      # 日志/错误里可读
+        return f"<{type(self).__name__} {self.kind} {self.address}>"
+
+
+def capabilities_from(**kwargs: Any) -> Capabilities:
+    """只给部分字段时其余仍为 False；测试与子类都用它。"""
+    return Capabilities(**kwargs)
