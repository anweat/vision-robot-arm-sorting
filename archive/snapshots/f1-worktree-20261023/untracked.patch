+#!/usr/bin/env python3
+"""仿真控制台后端（`src/sim/sim_server.py`）。
+
+它和控制台是同一套 `/api/*`（仿真服务继承实机控制台的 App），另外多出：
+- `POST /api/sim/sort` / `/api/sim/sort/stop`、`GET /api/sim/sort`：跑真实分拣流水线
+- `/api/sim/world`、`/api/sim/detect` 等仿真世界与检测对照
+
+任务启停是网关概念，这里把仿真侧的入口包成和实机同名的 task 方法。
+"""
+from __future__ import annotations
+
+from .base import BackendError, Capabilities
+from .console import ConsoleBackend
+
+
+class SimBackend(ConsoleBackend):
+    kind = "sim"
+    name = "仿真控制台"
+
+    @property
+    def capabilities(self) -> Capabilities:
+        return Capabilities(
+            camera=True, task=True, task_rounds=True, pose=True, home=True,
+            profile=True, gripper=True, record=True, sample=True, verify=True,
+            freeze=True, export=True, sim_world=True, detect=True, onsite=False,
+            calibrate=False, measure=False,
+        )
+
+    # ---- 仿真世界 -----------------------------------------------------
+    def world(self) -> dict:
+        return self._request("/api/sim/world")
+
+    def options(self) -> dict:
+        return self._request("/api/sim/options")
+
+    def detect(self, conf: float = 0.25) -> dict:
+        return self._request(f"/api/sim/detect?conf={float(conf)}")
+
+    def annotated_world(self, conf: float = 0.25) -> bytes:
+        return self._image(f"/api/sim/annotated?conf={float(conf)}")
+
+    # ---- 任务 ---------------------------------------------------------
+    def task_start(self, rounds: int = 1, blocks: int = 4, seed: int | None = None) -> dict:
+        body: dict = dict(rounds=int(rounds), blocks=int(blocks))
+        if seed is not None:
+            body["seed"] = int(seed)
+        try:
+            return self._request("/api/sim/sort", body)
+        except BackendError as exc:
+            if "有页面持有操作权" in (exc.message or ""):
+                # 让调用方先 stop 再试；任务启动不该替用户抢操作权
+                raise BackendError("有页面持有操作权；先解除使能（stop）再启动任务",
+                                   status=409, code="arm_armed") from None
+            raise
+
+    def task_stop(self) -> dict:
+        return self._request("/api/sim/sort/stop", dict(source=self.owner))
+
+    def task_state(self) -> dict:
+        try:
+            state = self._request("/api/sim/sort")
+        except BackendError:
+            raise
+        if not isinstance(state, dict):
+            raise BackendError("仿真任务状态格式不对", status=502, code="bad_task_state")
+        state["supported"] = True
+        state["source"] = self.kind
+        return state
diff --git a/src/web/js/components.js b/src/web/js/components.js
new file mode 100644
index 0000000..1a72c3b
--- /dev/null
+++ b/src/web/js/components.js
@@ -0,0 +1,198 @@
+// 可复用的展示组件：卡片 / 徽章 / 关节条 / 横幅 / 空态 / 表格。
+// 这里只负责结构，动态文字一律先由调用方 esc() 或本文件内部 esc()；sim/real 差异不在这里判断。
+
+import { esc } from "./format.js";
+import { JOINT_LIMITS } from "./contract.js";
+
+/** 单张指标卡 */
+export const card = (label, value = "—", { testid = "", tone = "" } = {}) =>
+  `<div class="card"><span>${esc(label)}</span>` +
+  `<b${testid ? ` data-testid="${esc(testid)}"` : ""} class="${esc(tone)}">${esc(value)}</b></div>`;
+
+/** 指标卡组 */
+export const cardGrid = (items) => `<div class="cards">${items.map((item) => card(item[0], item[1], item[2] ?? {})).join("")}</div>`;
+
+/** 状态徽章 */
+export const badge = (text, tone = "", testid = "") =>
+  `<span class="chip ${esc(tone)}"${testid ? ` data-testid="${esc(testid)}"` : ""}>${esc(text)}</span>`;
+
+/** 表格空态行 */
+export const emptyRow = (colspan, text = "没有数据") =>
+  `<tr><td colspan="${Math.max(1, colspan | 0)}" class="dim empty">${esc(text)}</td></tr>`;
+
+/** 表格：headers 是字符串数组，rows 是已转义的 <tr> HTML 数组 */
+export const tableHtml = ({ headers, rows, testid = "", className = "table", empty = "没有数据", emptyColspan } = {}) =>
+  `<table class="${esc(className)}"${testid ? ` data-testid="${esc(testid)}"` : ""}>` +
+  `<thead><tr>${(headers ?? []).map((h) => `<th>${esc(h)}</th>`).join("")}</tr></thead>` +
+  `<tbody>${rows && rows.length ? rows.join("") : emptyRow(emptyColspan ?? (headers ?? []).length, empty)}</tbody></table>`;
+
+/** 横幅：title/meta/actions 都是已转义的 HTML 片段（调用方负责 esc 动态值） */
+export const bannerHtml = ({ tone = "", title = "", meta = "", actions = "", testid = "" } = {}) =>
+  `<div class="banner ${esc(tone)}"${testid ? ` data-testid="${esc(testid)}"` : ""}>` +
+  (title ? `<b>${title}</b>` : "") +
+  (meta ? `<span>${meta}</span>` : "") +
+  (actions ?? "") +
+  `</div>`;
+
+/** 只在内容变化时写 textContent，避免 2 Hz 状态刷新造成闪烁 */
+export function setText(el, value, tone = "") {
+  if (!el) return;
+  const text = String(value ?? "—");
+  if (el.textContent !== text) el.textContent = text;
+  if (tone !== undefined) el.className = tone;
+}
+
+/** 单行空态（非表格） */
+export const emptyState = (text) => `<p class="empty dim">${esc(text)}</p>`;
+
+const clamp = (v, min, max) => Math.min(max, Math.max(min, v));
+
+/**
+ * 六轴关节条。editable=false 时是只读回读条（实时页）；true 时是滑块（控制面板）。
+ * 回读值只接受调用方传入的 status.arm.joints_deg，绝不回落到日志 pose。
+ *
+ * @param {HTMLElement} host
+ * @param {{editable?: boolean, limits?: Array<{name:string,min:number,max:number}>,
+ *          testid?: {readback?: string, slider?: string, target?: string, dirty?: string}}} options
+ */
+export function createJointPanel(host, { editable = false, limits = JOINT_LIMITS, testid = {} } = {}) {
+  const names = limits.map((j, i) => j.name ?? `J${i + 1}`);
+  const rbId = testid.readback ?? (editable ? "ctl-joint-readback" : "joint-readback");
+  const rowId = testid.row ?? (editable ? "ctl-joint-row" : "joint-row");
+  const sliderId = editable ? (testid.slider ?? "joint-slider") : null;
+  const targetId = editable ? (testid.target ?? "joint-target") : null;
+  const dirtyId = editable ? (testid.dirty ?? "joint-dirty") : null;
+
+  host.innerHTML = limits.map((j, i) => `
+    <div class="joint${editable ? " editable" : ""}" data-joint="${i}" data-testid="${esc(rowId)}-j${i + 1}">
+      <span class="jname">${esc(names[i])}</span>
+      <strong class="jread" data-testid="${esc(rbId)}-j${i + 1}">—</strong>
+      ${editable
+        ? `<input class="jslider" type="range" min="${j.min}" max="${j.max}" step="1" value="${Math.round((j.min + j.max) / 2)}"
+             data-testid="${esc(sliderId)}-j${i + 1}" aria-label="${esc(names[i])}">
+           <em class="jtarget" data-testid="${esc(targetId)}-j${i + 1}">—</em>
+           <span class="jdirty" data-testid="${esc(dirtyId)}-j${i + 1}" hidden>已修改</span>`
+        : `<div class="bar"><i></i></div>`}` +
+    `</div>`).join("");
+
+  const rowEls = Array.from(host.querySelectorAll(".joint"));
+  const state = {
+    readback: new Array(limits.length).fill(null),
+    limits: limits.map((j) => ({ min: j.min, max: j.max })),
+    dirty: new Set(),
+  };
+
+  const sliderOf = (i) => rowEls[i]?.querySelector("input[type=range]") ?? null;
+  const readOf = (i) => rowEls[i]?.querySelector(".jread") ?? null;
+  const targetOf = (i) => rowEls[i]?.querySelector(".jtarget") ?? null;
+  const dirtyOf = (i) => rowEls[i]?.querySelector(".jdirty") ?? null;
+  const barOf = (i) => rowEls[i]?.querySelector(".bar i") ?? null;
+
+  function limitsOf(i, liveLimits) {
+    if (liveLimits) {
+      const l = liveLimits[String(i + 1)] ?? liveLimits[i + 1] ?? liveLimits[i];
+      if (Array.isArray(l) && l.length >= 2 && Number.isFinite(+l[0]) && Number.isFinite(+l[1])) {
+        return { min: +l[0], max: +l[1] };
+      }
+    }
+    const base = limits[i] ?? { min: 0, max: 180 };
+    return { min: base.min, max: base.max };
+  }
+
+  function applyLimits(i, lim) {
+    const input = sliderOf(i);
+    if (!input) return;
+    if (+input.min !== lim.min) input.min = lim.min;
+    if (+input.max !== lim.max) input.max = lim.max;
+    if (+input.value < lim.min || +input.value > lim.max) input.value = clamp(+input.value, lim.min, lim.max);
+  }
+
+  function refreshRow(i) {
+    const value = state.readback[i];
+    const lim = state.limits[i];
+    const out = value != null && (value < lim.min || value > lim.max);
+    const read = readOf(i);
+    if (read) {
+      const text = value == null ? "—" : `${Math.round(value)}°`;
+      if (read.textContent !== text) read.textContent = text;
+      read.className = out ? "jread bad" : "jread";
+    }
+    const input = sliderOf(i);
+    if (!input) {
+      const bar = barOf(i);
+      if (bar) {
+        const ratio = value == null ? 0 : (value - lim.min) / Math.max(1, lim.max - lim.min);
+        bar.style.width = `${clamp(ratio, 0, 1) * 100}%`;
+        bar.classList.toggle("bad", out);
+      }
+      return;
+    }
+    const target = +input.value;
+    const dirty = state.dirty.has(i) && (value == null || Math.round(value) !== target);
+    if (dirty) state.dirty.add(i); else state.dirty.delete(i);
+    input.classList.toggle("dirty", dirty);
+    const targetEl = targetOf(i);
+    if (targetEl) {
+      const text = `${target}°`;
+      if (targetEl.textContent !== text) targetEl.textContent = text;
+      targetEl.className = dirty ? "jtarget mid" : "jtarget dim";
+    }
+    const dirtyEl = dirtyOf(i);
+    if (dirtyEl) dirtyEl.hidden = !dirty;
+  }
+
+  if (editable) {
+    host.addEventListener("input", (ev) => {
+      const input = ev.target.closest("input[type=range]");
+      if (!input) return;
+      const i = +input.closest(".joint").dataset.joint;
+      state.dirty.add(i);
+      refreshRow(i);
+    });
+  }
+
+  return {
+    /** @param {Array<number|null>|null} values status.arm.joints_deg */
+    update(values, liveLimits = null) {
+      for (let i = 0; i < limits.length; i += 1) {
+        const value = Array.isArray(values) && Number.isFinite(values[i]) ? values[i] : null;
+        state.readback[i] = value;
+        const lim = limitsOf(i, liveLimits);
+        state.limits[i] = lim;
+        applyLimits(i, lim);
+        const input = sliderOf(i);
+        if (editable && input && !state.dirty.has(i) && value != null) {
+          input.value = String(Math.round(clamp(value, +input.min, +input.max)));
+        }
+        refreshRow(i);
+      }
+    },
+    /** 以回读为准重置所有滑块，清掉“已修改” */
+    syncAll() {
+      state.dirty.clear();
+      for (let i = 0; i < limits.length; i += 1) {
+        const input = sliderOf(i);
+        if (input && state.readback[i] != null) {
+          input.value = String(Math.round(clamp(state.readback[i], +input.min, +input.max)));
+        }
+        refreshRow(i);
+      }
+    },
+    /** 滑块当前目标值 */
+    values() {
+      return limits.map((_, i) => (sliderOf(i) ? +sliderOf(i).value : (state.readback[i] ?? 0)));
+    },
+    /** 有改动的轴下标（滑块值与回读四舍五入后不同） */
+    changed() {
+      const out = [];
+      for (let i = 0; i < limits.length; i += 1) {
+        const input = sliderOf(i);
+        if (!input || !state.dirty.has(i)) continue;
+        if (state.readback[i] == null || Math.round(state.readback[i]) !== +input.value) out.push(i);
+      }
+      return out;
+    },
+    readback() { return state.readback.slice(); },
+    editable,
+  };
+}
