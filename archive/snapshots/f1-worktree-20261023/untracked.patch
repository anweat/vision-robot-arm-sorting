+#!/usr/bin/env python3
+"""执行侧后端工厂。
+
+`--console <url>` 指向仿真或实机控制台；不指定时网关只有日志与定时任务，
+`GET /api/status` 里 backend=null。`--backend auto`（默认）看 bootstrap.status
+里有没有 `sim` 键；`--backend sim|real` 可强制，便于用离线控制台验证实机形态。
+"""
+from __future__ import annotations
+
+from .base import ArmBackend, BackendError, Capabilities
+from .console import ConsoleBackend, probe_kind
+from .real import RealBackend
+from .sim import SimBackend
+
+
+def create_backend(address: str | None, owner: str = "web", kind: str = "auto",
+                   timeout: float = 30.0) -> ArmBackend | None:
+    if not address:
+        return None
+    if kind not in ("auto", "sim", "real"):
+        raise ValueError("backend 只能是 auto/sim/real")
+    if kind == "auto":
+        kind = probe_kind(address)
+    cls = SimBackend if kind == "sim" else RealBackend
+    return cls(address, owner=owner, timeout=timeout)
+
+
+__all__ = ["ArmBackend", "BackendError", "Capabilities", "ConsoleBackend",
+           "RealBackend", "SimBackend", "create_backend"]
