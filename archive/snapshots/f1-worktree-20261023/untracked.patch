+#!/usr/bin/env python3
+"""控制台（HTTP）后端：仿真 `src/sim/sim_server.py` 与实机 `src/teleop/server.py` 共用。
+
+接口文档 §4：GET 查询（status/frame/...）不需要 token；POST 动作要
+`X-Console-Token` 与 `owner`，运动还要新鲜 `revision`。控制台拒绝时回 409/400，
+中文原因原样向上透传。
+"""
+from __future__ import annotations
+
+import json
+import time
+import urllib.error
+import urllib.request
+
+from .base import ArmBackend, BackendError, Capabilities
+
+
+class ConsoleBackend(ArmBackend):
+    kind = "real"
+    name = "控制台"
+
+    def __init__(self, address: str, owner: str = "web", timeout: float = 30.0):
+        super().__init__(address, owner, timeout)
+        self.token: str | None = None
+        self._bootstrap: dict | None = None
+        self._last_status: dict | None = None
+        self._last_status_at: float = 0.0
+
+    # ---- HTTP ---------------------------------------------------------
+    def _build(self, path: str, body: dict | None, method: str | None):
+        data = json.dumps(body, ensure_ascii=False).encode() if body is not None else None
+        req = urllib.request.Request(self.address + path, data=data, method=method or ("POST" if data else "GET"))
+        if data:
+            req.add_header("Content-Type", "application/json")
+        if self.token:
+            req.add_header("X-Console-Token", self.token)
+        return req
+
+    def _once(self, path: str, body: dict | None = None, method: str | None = None):
+        req = self._build(path, body, method)
+        try:
+            with urllib.request.urlopen(req, timeout=self.timeout) as res:
+                raw = res.read()
+                mime = res.headers.get("Content-Type", "")
+        except urllib.error.HTTPError as exc:
+            raw = exc.read()
+            message, code = self._error_of(raw, exc.code, path)
+            raise BackendError(message, status=409 if exc.code == 409 else
+                               (400 if exc.code in (400, 422) else 502),
+                               code=code, upstream=exc.code) from None
+        except urllib.error.URLError as exc:
+            raise BackendError(f"连不上控制台 {self.address}：{exc.reason}", status=503,
+                               code="console_unreachable") from None
+        except (OSError, ValueError) as exc:
+            raise BackendError(f"控制台请求失败：{exc}", status=502, code="console_error") from None
+        if "json" in mime:
+            try:
+                return json.loads(raw or b"{}")
+            except ValueError:
+                raise BackendError("控制台返回了无效 JSON", status=502, code="bad_console_json")
+        return raw
+
+    @staticmethod
+    def _error_of(raw: bytes, upstream: int, path: str) -> tuple[str, str | None]:
+        try:
+            payload = json.loads(raw or b"{}")
+        except ValueError:
+            return f"控制台 {upstream} {path}", None
+        if isinstance(payload, dict):
+            return payload.get("error") or f"控制台 {upstream} {path}", payload.get("code")
+        return f"控制台 {upstream} {path}", None
+
+    def _request(self, path: str, body: dict | None = None, method: str | None = None,
+                 retry_token: bool = True):
+        """控制台重启会让旧凭证失效；按错误文案/409 重取一次 token 再试。"""
+        if self.token is None and path != "/api/bootstrap":
+            self._ensure_bootstrap()
+        try:
+            return self._once(path, body, method)
+        except BackendError as exc:
+            if not retry_token or "凭证" not in (exc.message or ""):
+                raise
+        self.token = None
+        self._ensure_bootstrap()
+        return self._once(path, body, method)
+
+    def _ensure_bootstrap(self) -> dict:
+        if self._bootstrap is None or self.token is None:
+            info = self._once("/api/bootstrap")
+            if not isinstance(info, dict):
+                raise BackendError("控制台 bootstrap 返回格式不对", status=502, code="bad_bootstrap")
+            self.token = info.get("token")
+            self._bootstrap = info
+        return self._bootstrap
+
+    def bootstrap(self) -> dict:
+        return self._ensure_bootstrap()
+
+    def scene(self) -> dict | None:
+        try:
+            return self._ensure_bootstrap().get("scene")
+        except BackendError:
+            return None
+
+    # ---- 状态 ---------------------------------------------------------
+    def status(self) -> dict:
+        raw = self._request("/api/status")
+        if not isinstance(raw, dict):
+            raise BackendError("控制台 status 返回格式不对", status=502, code="bad_status")
+        norm = self._normalize(raw)
+        self._last_status, self._last_status_at = norm, time.time()
+        return norm
+
+    def cached_status(self) -> dict | None:
+        return self._last_status
+
+    @staticmethod
+    def _normalize(raw: dict) -> dict:
+        """保留控制台给的全部字段，另加页面真正要用的厘米/骨架点。"""
+        out = dict(raw)
+        fk = raw.get("fk") if isinstance(raw.get("fk"), dict) else {}
+        chain = {k: [round(float(v) * 100, 2) for v in p]
+                 for k, p in fk.items() if isinstance(p, list) and len(p) == 3}
+        if chain:
+            chain["base"] = [0.0, 0.0, 0.0]
+        out["chain_cm"] = chain or None
+        out["tip_cm"] = chain.get("tip") if chain else None
+        pitch = fk.get("tip_pitch_deg")
+        out["tip_pitch_deg"] = pitch[0] if isinstance(pitch, list) and pitch else None
+        out["mode"] = raw.get("mode")
+        out["camera"] = raw.get("camera")
+        out["recording"] = raw.get("recording")
+        out["samples"] = raw.get("samples")
+        out["localization"] = raw.get("localization")
+        out["sim"] = raw.get("sim")
+        out["limits"] = raw.get("limits")
+        out["age_s"] = raw.get("age_s")
+        return out
+
+    def revision(self) -> int:
+        return int(self.status().get("revision") or 0)
+
+    def _refreshed(self) -> dict:
+        """动作后回读一次，顺手更新缓存。"""
+        try:
+            return self.status()
+        except BackendError:
+            return {}
+
+    # ---- 操作权 -------------------------------------------------------
+    def enable(self, onsite: bool = False) -> dict:
+        self._request("/api/enable", dict(owner=self.owner, onsite=bool(onsite)))
+        return self._refreshed()
+
+    def heartbeat(self) -> dict:
+        return self._request("/api/heartbeat", dict(owner=self.owner))
+
+    def stop(self) -> dict:
+        self._request("/api/stop", dict(owner=self.owner))
+        return self._refreshed()
+
+    # ---- 运动 ---------------------------------------------------------
+    def _motion(self, path: str, body: dict, revision: int | None = None) -> dict:
+        """自动补新鲜 revision；遇到「状态已变化」重取一次。"""
+        for attempt in range(2):
+            rev = revision if revision is not None else self.revision()
+            try:
+                self._request(path, dict(body, owner=self.owner, revision=rev))
+                return self._refreshed()
+            except BackendError as exc:
+                if revision is not None or attempt or not _revision_stale(exc):
+                    raise
+        raise BackendError("姿态已变化，请重试", status=409, code="revision_stale")
+
+    def jog(self, joint: int, delta: int, revision: int | None = None) -> dict:
+        return self._motion("/api/jog", dict(joint=int(joint), delta=int(delta)), revision)
+
+    def cartesian(self, axis: str, amount: float, revision: int | None = None) -> dict:
+        return self._motion("/api/cartesian", dict(axis=axis, amount=amount), revision)
+
+    def gripper(self, action: str, revision: int | None = None) -> dict:
+        return self._motion("/api/gripper", dict(action=action), revision)
+
+    def pose_plan(self, target: list) -> dict:
+        return self._request("/api/pose/plan", dict(owner=self.owner, target=list(target)))
+
+    def pose_execute(self, plan_id: str, revision: int) -> dict:
+        self._request("/api/pose/execute", dict(owner=self.owner, plan_id=plan_id, revision=int(revision)))
+        return self._refreshed()
+
+    def home_plan(self) -> dict:
+        return self._request("/api/home/plan", dict(owner=self.owner))
+
+    def home_execute(self, plan_id: str, revision: int) -> dict:
+        self._request("/api/home/execute", dict(owner=self.owner, plan_id=plan_id, revision=int(revision)))
+        return self._refreshed()
+
+    def set_profile(self, name: str, onsite: bool = False) -> dict:
+        self._request("/api/profile", dict(owner=self.owner, name=name, onsite=bool(onsite)))
+        return self._refreshed()
+
+    # ---- 录制/标定 ----------------------------------------------------
+    def record(self, on: bool, label: str = "", note: str = "") -> dict:
+        self._request("/api/record", dict(owner=self.owner, on=bool(on), label=label, note=note))
+        return self._refreshed()
+
+    def sample(self, kind: str, label: str = "", note: str = "") -> dict:
+        return self._request("/api/sample", dict(owner=self.owner, kind=kind, label=label, note=note))
+
+    def verify(self, kind: str, note: str = "") -> dict:
+        return self._request("/api/verify", dict(owner=self.owner, kind=kind, note=note))
+
+    def localization_save(self) -> dict:
+        return self._request("/api/localization/save", dict(owner=self.owner))
+
+    def freeze(self) -> dict:
+        return self._request("/api/freeze", dict(owner=self.owner))
+
+    def calibrate(self, frame_id: str, plane: str, points: list) -> dict:
+        return self._request("/api/calibrate", dict(owner=self.owner, frame_id=frame_id,
+                                                    plane=plane, points=points))
+
+    def measure(self, frame_id: str, pixels: list) -> dict:
+        return self._request("/api/measure", dict(owner=self.owner, frame_id=frame_id, pixels=pixels))
+
+    # ---- 画面 ---------------------------------------------------------
+    def _image(self, path: str) -> bytes:
+        raw = self._request(path)
+        if not isinstance(raw, (bytes, bytearray)):
+            raise BackendError(f"{path} 没有返回图片", status=502, code="bad_image")
+        return bytes(raw)
+
+    def frame(self) -> bytes:
+        return self._image("/api/frame")
+
+    def phone_frame(self) -> bytes:
+        return self._image("/api/phone")
+
+    def frozen_frame(self) -> bytes:
+        return self._image("/api/frozen")
+
+    def annotated(self, which: str) -> bytes:
+        if which not in ("board", "phone"):
+            raise BackendError("标注图只有 board/phone", status=400)
+        return self._image(f"/api/annotated/{which}")
+
+    def export(self) -> dict:
+        return self._request("/api/export")
+
+    # ---- 任务（控制台本身没有；子类实现） -----------------------------
+    def task_state(self) -> dict:
+        return dict(supported=False, running=False, source=self.kind)
+
+
+def _revision_stale(exc: BackendError) -> bool:
+    text = exc.message or ""
+    return exc.status == 409 and ("状态已变化" in text or "revision" in text.lower())
+
+
+def probe_kind(address: str, timeout: float = 5.0) -> str:
+    """bootstrap.status 里带 `sim` 的是仿真后端；否则按实机控制台对待。
+
+    实机控制台在离线模拟模式下 `mode` 也是 simulation，所以不能用 mode 区分。
+    """
+    url = address.rstrip("/") + "/api/bootstrap"
+    try:
+        with urllib.request.urlopen(url, timeout=timeout) as res:
+            info = json.loads(res.read() or b"{}")
+    except Exception:
+        return "real"
+    status = info.get("status") if isinstance(info, dict) else None
+    return "sim" if isinstance(status, dict) and "sim" in status else "real"
