+"""任务轮次：一次 start = 一个任务 = 一轮，YOLO/回放事件只做明细。标准库 unittest。"""
+import json
+import sys
+import tempfile
+import time
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'src' / 'web'))
+sys.path.insert(0, str(ROOT / 'src' / 'tools'))
+from backends.base import BackendError, Capabilities  # noqa: E402
+from task import TaskTracker  # noqa: E402
+
+
+class FakeBackend:
+    kind = 'sim'
+    address = 'fake://'
+
+    def __init__(self):
+        self.capabilities = Capabilities(task=True, pose=True)
+        self.armed = True
+        self.running = False
+        self.stopped = 0
+        self.calls = []
+
+    def status(self):
+        return dict(pose=[90, 105, 5, 5, 95, 30], armed=self.armed)
+
+    def stop(self):
+        self.armed = False
+        self.calls.append(('stop',))
+
+    def task_start(self, rounds=1, blocks=4, seed=None):
+        self.running = True
+        self.calls.append(('start', rounds))
+        return dict(running=True, exit_code=None, output=[], log_lines=0)
+
+    def task_stop(self):
+        self.running = False
+        self.stopped += 1
+        return dict(running=False)
+
+    def task_state(self):
+        return dict(running=self.running, exit_code=0 if not self.running else None,
+                    output=[], log_lines=0)
+
+
+class TaskTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.log = Path(self.tmp.name) / 'log.jsonl'
+        self.log.write_text('', encoding='utf-8')
+        self.events = []
+        self.backend = FakeBackend()
+        self.task = TaskTracker(self.backend, self.log, self.events.append)
+
+    def event(self, name, t=None, **data):
+        with self.log.open('a', encoding='utf-8') as f:
+            f.write(json.dumps(dict(event=name, t=time.time() if t is None else t, **data)) + '\n')
+
+    def test_one_start_is_one_round_and_counts_only_its_own_events(self):
+        # 任务开始之前的历史/回放事件不计入
+        self.event('pipeline_start', t=time.time() - 100)
+        self.event('pipeline_end', t=time.time() - 90)
+        task = self.task.start(source='web', rounds=1)
+        self.assertTrue(task['running'])
+        self.assertTrue(self.backend.calls[0][0] == 'stop')       # 先释放操作权
+        self.event('pipeline_start')
+        self.event('pipeline_sorted', cube=[1, 2], category='other', bin='44', seconds=1)
+        self.event('pipeline_end', sorted=1, skipped=0, missed=0, cleared=0, seconds=2)
+        task = self.task.poll(force=True)
+        self.assertEqual(task['current_round'], 1)
+        self.assertEqual(task['rounds_done'], 1)
+        self.backend.running = False
+        task = self.task.poll(force=True)
+        self.assertEqual(task['state'], 'finished')
+        self.assertEqual(task['exit_code'], 0)
+        self.assertEqual(task['rounds_done'], 1)
+
+    def test_replay_events_are_not_task_progress(self):
+        self.task.start(source='web')
+        self.event('pipeline_start', replay=True)
+        self.event('pipeline_end', replay=True, sorted=4, skipped=0, missed=0, cleared=0, seconds=9)
+        self.assertEqual(self.task.poll(force=True)['current_round'], 0)
+        self.assertEqual(self.task.status()['rounds_done'], 0)
+
+    def test_a_running_task_cannot_be_started_twice(self):
+        self.task.start(source='web')
+        with self.assertRaises(BackendError) as ctx:
+            self.task.start(source='web')
+        self.assertEqual(ctx.exception.status, 409)
+
+    def test_stop_marks_stopped_and_writes_an_event(self):
+        self.task.start(source='web')
+        stopped = self.task.stop()
+        self.assertFalse(stopped['running'])
+        self.assertEqual(stopped['state'], 'stopped')
+        self.assertEqual(self.backend.stopped, 1)
+        self.assertEqual(self.events[-1]['event'], 'stopped')
+
+    def test_failed_exit_code_is_reported_as_failed(self):
+        self.task.start(source='web')
+        self.backend.running = False
+        self.backend.task_state = lambda: dict(running=False, exit_code=2, output=['boom'], log_lines=1)
+        task = self.task.poll(force=True)
+        self.assertEqual(task['state'], 'failed')
+        self.assertEqual(task['exit_code'], 2)
+        self.assertIn('退出码', task['error'])
+
+    def test_no_backend_says_so_instead_of_pretending(self):
+        task = TaskTracker(None, self.log, self.events.append)
+        self.assertFalse(task.supported)
+        with self.assertRaises(BackendError) as ctx:
+            task.start(source='timer')
+        self.assertEqual(ctx.exception.status, 501)
+        self.assertIn('控制台', ctx.exception.message)
+
+
+if __name__ == '__main__':
+    unittest.main()
